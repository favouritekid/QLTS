# Mẫu env ỨNG DỤNG cho stack smoke — chép thành `.env.smoke.app` rồi điền.
# `.env.smoke.app` KHÔNG được commit (đã có trong .gitignore).
#
# Tệp này là thứ `QLTS_ENV_FILE` trỏ tới. Nó thay `.env.production` cho backend và
# hai Celery, nên vai trò chính của nó là **không mang gì của production sang**.
#
# ⚠️ KHÔNG khai `DATABASE_URL` ở đây: `docker-compose.yml` dựng biến ấy trong
# `environment:` từ `POSTGRES_*`, và `environment:` thắng `env_file`. Khai thêm ở đây
# chỉ tạo hai nguồn cho cùng một giá trị.

APP_ENV=development

SECRET_KEY=DIEN_CHUOI_NGAU_NHIEN_KHAC
JWT_SECRET_KEY=DIEN_CHUOI_NGAU_NHIEN_KHAC_NUA

# ---------------------------------------------------------------------------
# URL — Chrome chạy trên host, nên mọi đường phải trỏ cổng của stack smoke
# ---------------------------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:3100
PUBLIC_BACKEND_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://127.0.0.1:3100

# ---------------------------------------------------------------------------
# Outbound: khai RỖNG TƯỜNG MINH, đừng dựa vào "không khai thì thôi"
# ---------------------------------------------------------------------------
# Một khoá bị bỏ quên ở đây nghĩa là giá trị production có thể chui vào qua một
# đường khác (biến môi trường của shell, một env_file khác), và stack smoke sẽ gọi
# tích hợp THẬT bằng dữ liệu thử. Khai rỗng làm điều đó không xảy ra âm thầm.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
ZALO_WEBHOOK_SECRET=
ZALO_OA_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ⚠️ Khai RỖNG là chưa đủ cho những khoá có MẶC ĐỊNH GỌI RA NGOÀI trong
# `app/config.py`. Bốn nhóm dưới đây `docker compose config` KHÔNG nhìn thấy, vì
# chúng là default của Pydantic chứ không phải giá trị trong env file:
#
#   HIBP_CHECK_ENABLED      default True   -> gọi api.pwnedpasswords.com
#   SMS_PUBLIC_BASE_URL     default https://qlts.tnpc.edu.vn   (tên miền THẬT)
#   SMS_ALLOWED_REDIRECT_DOMAINS default qlts.tnpc.edu.vn,tnpc.edu.vn
#   VNPAY_PAYMENT_URL/_API_URL   default sandbox.vnpayment.vn
#   MOMO_ENDPOINT           default test-payment.momo.vn
#
# Không đặt lại ở đây thì stack smoke vẫn gọi ra Internet và vẫn mang tên miền
# production trong link SMS.
HIBP_CHECK_ENABLED=False
SMS_PUBLIC_BASE_URL=http://127.0.0.1:3100
SMS_ALLOWED_REDIRECT_DOMAINS=127.0.0.1
VNPAY_PAYMENT_URL=http://127.0.0.1:9/vnpay-khong-ton-tai
VNPAY_API_URL=http://127.0.0.1:9/vnpay-khong-ton-tai
MOMO_ENDPOINT=http://127.0.0.1:9/momo-khong-ton-tai
# Hai master switch: mặc định đã là False, nhưng khai tường minh để một lần đổi
# default ở `config.py` không lặng lẽ bật tích hợp trong stack smoke.
ZALO_ENABLED=False
ZALO_BOT_ENABLED=False
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=

# MailHog/localhost — cổng 1025 không có ai nghe trong stack này, nên thư đi đâu
# cũng hỏng ngay tại chỗ thay vì bay ra ngoài.
MAIL_USERNAME=smoke@smoke.invalid
MAIL_PASSWORD=
MAIL_FROM=smoke@smoke.invalid
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_STARTTLS=False
MAIL_SSL_TLS=False

# ⚠️ KHÔNG đặt mật khẩu persona ở đây. Tệp này được cấp cho backend và HAI Celery;
# một mật khẩu tài khoản nằm trong đó là vượt least privilege, và một giá trị dùng
# chung cho sáu persona thì trái hợp đồng "mỗi persona một mật khẩu riêng".
# Nó thuộc `.env.smoke.runner` — chỉ `smoke-runner` được đọc.
