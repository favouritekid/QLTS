# ============================================
# .env.test - Test Environment Configuration
# ============================================
# 🚨 CRITICAL: This file is ONLY for automated testing 🚨
#
# SAFETY REQUIREMENTS:
# - APP_ENV MUST be "test"
# - DATABASE_URL MUST contain "test" in database name
# - Tests will DROP ALL TABLES automatically before each test
# - NEVER point to production or development database!
#
# Copy this file to .env.test and update with your settings:
#   cp .env.test.example .env.test
# ============================================

# ============================================
# 1. Application Environment (CRITICAL)
# ============================================
APP_ENV=test

# ============================================
# 2. Database Configuration (CRITICAL)
# ============================================
# Option 1: PostgreSQL test database (RECOMMENDED for integration tests)
# 🚨 Database name MUST contain "test" for safety checks to pass!
# Replace these placeholder values with your actual test database credentials:
DATABASE_URL="postgresql+asyncpg://postgres:your_password@your_host:5432/qlts_test"

# Common examples:
# DATABASE_URL="postgresql+asyncpg://postgres:admintest@192.168.0.120:5432/qlts_test"
# DATABASE_URL="postgresql+asyncpg://postgres:admintest@localhost:5432/qlts_test"
# DATABASE_URL="postgresql+asyncpg://testuser:testpass@localhost:5433/my_test_db"

# ⚠️  IMPORTANT: Database name MUST contain the word "test"
# ✅ Good: qlts_test, my_test_db, test_database, db_test
# ❌ Bad: your_test_db_name, qlts_dev, qlts, production

# Option 2: SQLite in-memory (FASTEST, no setup required)
# DATABASE_URL="sqlite+aiosqlite:///:memory:"

# 🚨 NEVER USE THESE (will be blocked by safety checks):
# DATABASE_URL="postgresql+asyncpg://postgres:admin@localhost:5432/qlts_dev"  ❌ Development DB
# DATABASE_URL="postgresql+asyncpg://postgres:admin@localhost:5432/qlts_prod" ❌ Production DB
# DATABASE_URL="sqlite:///./qlts.db"                                           ❌ File-based prod DB

# ============================================
# 3. Redis Configuration (CRITICAL)
# ============================================
# Use DIFFERENT Redis DB numbers for tests (11-13) to avoid conflicts
REDIS_URL="redis://localhost:6379/11"              # Cache/rate limiting
CELERY_BROKER_URL="redis://localhost:6379/12"      # Celery task queue
CELERY_RESULT_BACKEND_URL="redis://localhost:6379/13"  # Celery results

# Alternative: Use different Redis port if running test Redis instance
# REDIS_URL="redis://localhost:6380/1"
# CELERY_BROKER_URL="redis://localhost:6380/2"
# CELERY_RESULT_BACKEND_URL="redis://localhost:6380/3"

# ============================================
# 4. Security Keys (REQUIRED)
# ============================================
# Use DIFFERENT keys from production/development
SECRET_KEY="test-secret-key-12345-not-for-production"
JWT_SECRET_KEY="test-jwt-secret-key-67890-not-for-production"
JWT_ALGORITHM="HS256"

# Token expiry (can be shorter for faster tests)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 5. Mail Server (REQUIRED)
# ============================================
# Option 1: MailHog (RECOMMENDED - local test mail server)
#   Docker: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   Web UI: http://localhost:8025
MAIL_SERVER="localhost"
MAIL_PORT=1025
MAIL_USERNAME=""  # MailHog doesn't need auth
MAIL_PASSWORD=""
MAIL_FROM="test@example.com"
MAIL_STARTTLS=false
MAIL_SSL_TLS=false

# Option 2: Mailtrap (cloud-based test mail)
# MAIL_SERVER="sandbox.smtp.mailtrap.io"
# MAIL_PORT=2525
# MAIL_USERNAME="your-mailtrap-username"
# MAIL_PASSWORD="your-mailtrap-password"
# MAIL_FROM="test@yourdomain.com"
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false

# 🚨 NEVER use production mail server credentials here!

# ============================================
# 6. Frontend URL (Optional)
# ============================================
FRONTEND_URL="http://localhost:3000"

# ============================================
# 7. CORS Origins (Optional)
# ============================================
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ============================================
# 8. Logging (Optional)
# ============================================
LOG_LEVEL="DEBUG"  # More verbose logging for tests

# ============================================
# 9. File Upload Limits (Optional)
# ============================================
MAX_AVATAR_SIZE_MB=2

# ============================================
# 10. GeoIP Development (Optional)
# ============================================
# For testing location features
DEV_GEOIP_TEST_IP="103.28.36.1"  # Vietnam IP

# ============================================
# Notes:
# ============================================
# - Tests automatically load this file when APP_ENV=test
# - conftest.py sets APP_ENV=test before loading config
# - Safety checks verify database is safe before dropping tables
# - Each test function gets fresh database (all tables recreated)
# - Redis data is automatically flushed between tests
# - Rate limits are set to high values (1000/min) for tests
# ============================================
