# ============================================
# QLTS Backend Environment Variables
# ============================================
# Copy this file to .env and update with your settings
# cp .env.development.example .env

# ============================================
# Application Settings
# ============================================
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
API_BASE_URL=http://localhost:8000

# ============================================
# Database Settings
# ============================================
DATABASE_URL=sqlite:///./qlts.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/qlts_db

# ============================================
# JWT Settings
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# Email Settings (for suspicious login alerts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# ============================================
# Redis Settings (for Celery background tasks)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# CORS Settings
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# GeoIP Development Mode
# ============================================
# Uncomment and set to test GeoIP features on localhost
# When set, localhost (127.0.0.1) will be treated as this IP for GeoIP lookup
# This allows testing location features without deploying to a public server

# Vietnam IPs:
DEV_GEOIP_TEST_IP=103.28.36.1        # Hanoi, Vietnam (VNPT)
# DEV_GEOIP_TEST_IP=45.117.80.1      # Ho Chi Minh City, Vietnam (FPT)
# DEV_GEOIP_TEST_IP=113.161.0.1      # Ho Chi Minh City, Vietnam (VNPT)

# International IPs for testing:
# DEV_GEOIP_TEST_IP=8.8.8.8          # Mountain View, United States (Google)
# DEV_GEOIP_TEST_IP=1.1.1.1          # Sydney, Australia (Cloudflare)
# DEV_GEOIP_TEST_IP=185.228.168.1    # London, United Kingdom
# DEV_GEOIP_TEST_IP=103.2.28.1       # Singapore

# Test Impossible Travel Detection:
# 1. Set DEV_GEOIP_TEST_IP=103.28.36.1 (Vietnam)
# 2. Login and note the session location
# 3. Change to DEV_GEOIP_TEST_IP=8.8.8.8 (USA)
# 4. Restart backend: uvicorn app.main:app --reload
# 5. Login again within 2 hours
# 6. Check if session is marked as "Suspicious" ✓

# Note: In production (with real public IPs), this variable has no effect
#       It only activates when the actual IP is private (127.x.x.x, 192.168.x.x, etc.)
