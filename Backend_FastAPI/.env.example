# ============================================
# QLTS Backend Environment Variables
# ============================================
# Copy this file to .env and update with your settings:
#   cp .env.example .env
#
# 🚨 IMPORTANT: TESTING SAFETY 🚨
# ============================================
# This file is for DEVELOPMENT/PRODUCTION only.
#
# For TESTING:
# - Tests automatically use .env.test (NOT this file)
# - .env.test MUST use database name containing "test"
# - Tests will DROP ALL TABLES - NEVER use production database!
#
# Safety checks will prevent tests from running if:
# - APP_ENV is not "test"
# - DATABASE_URL doesn't contain "test" in database name
# ============================================

# ============================================
# 1. Application Settings
# ============================================
APP_ENV="development"  # Options: development, production
DEBUG=True

# Security keys - CHANGE THESE in production!
SECRET_KEY="your-secret-key-here-change-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-here-change-in-production"
JWT_ALGORITHM="HS256"

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# 2. Database Settings
# ============================================
# Option 1: SQLite (for development/testing)
DATABASE_URL="sqlite+aiosqlite:///./qlts_dev.db"

# Option 2: PostgreSQL (RECOMMENDED for production)
# DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/qlts_dev"
# DATABASE_URL="postgresql+asyncpg://postgres:admin@192.168.0.120:5432/qlts_dev"

# Production example:
# DATABASE_URL="postgresql+asyncpg://qlts_user:secure_password@db.example.com:5432/qlts_production"

# ============================================
# 3. Redis Settings
# ============================================
# Different DB numbers for different purposes
REDIS_URL="redis://localhost:6379/1"              # Cache/rate limiting
CELERY_BROKER_URL="redis://localhost:6379/2"      # Celery task queue
CELERY_RESULT_BACKEND_URL="redis://localhost:6379/3"  # Celery results

# Remote Redis example:
# REDIS_URL="redis://192.168.0.120:6379/1"

# ============================================
# 4. Mail Settings
# ============================================
# For development: Use Mailtrap or MailHog

# Option 1: Mailtrap (cloud-based test mail)
MAIL_SERVER="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USERNAME="your-mailtrap-username"
MAIL_PASSWORD="your-mailtrap-password"
MAIL_FROM="noreply@yourdomain.com"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Option 2: MailHog (local test mail server)
# Docker: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
# MAIL_SERVER="localhost"
# MAIL_PORT=1025
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_FROM="noreply@yourdomain.com"
# MAIL_STARTTLS=false
# MAIL_SSL_TLS=false

# Production example (Gmail):
# MAIL_SERVER="smtp.gmail.com"
# MAIL_PORT=587
# MAIL_USERNAME="your-email@gmail.com"
# MAIL_PASSWORD="your-app-specific-password"
# MAIL_FROM="your-email@gmail.com"
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false

# ============================================
# 5. Frontend URL
# ============================================
FRONTEND_URL="http://localhost:3000"

# Production example:
# FRONTEND_URL="https://app.yourdomain.com"

# ============================================
# 6. CORS Origins
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.120:3000"

# Production example:
# CORS_ORIGINS="https://app.yourdomain.com,https://www.yourdomain.com"

# ============================================
# 7. Logging
# ============================================
LOG_LEVEL="DEBUG"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Production should use:
# LOG_LEVEL="INFO"

# ============================================
# 8. File Upload Settings
# ============================================
MAX_AVATAR_SIZE_MB=2

# ============================================
# 9. API Base URL
# ============================================
API_BASE_URL="http://localhost:8000"

# Production example:
# API_BASE_URL="https://api.yourdomain.com"

# ============================================
# 10. GeoIP Development Mode
# ============================================
# For testing location features on localhost
# When set, localhost (127.0.0.1) will be treated as this IP for GeoIP lookup

# Vietnam IPs:
DEV_GEOIP_TEST_IP="103.28.36.1"        # Hanoi, Vietnam (VNPT)
# DEV_GEOIP_TEST_IP="45.117.80.1"      # Ho Chi Minh City, Vietnam (FPT)
# DEV_GEOIP_TEST_IP="113.161.0.1"      # Ho Chi Minh City, Vietnam (VNPT)

# International IPs for testing:
# DEV_GEOIP_TEST_IP="8.8.8.8"          # Mountain View, United States (Google)
# DEV_GEOIP_TEST_IP="1.1.1.1"          # Sydney, Australia (Cloudflare)
# DEV_GEOIP_TEST_IP="185.228.168.1"    # London, United Kingdom
# DEV_GEOIP_TEST_IP="103.2.28.1"       # Singapore

# Test Impossible Travel Detection:
# 1. Set DEV_GEOIP_TEST_IP=103.28.36.1 (Vietnam)
# 2. Login and note the session location
# 3. Change to DEV_GEOIP_TEST_IP=8.8.8.8 (USA)
# 4. Restart backend: uvicorn app.main:app --reload
# 5. Login again within 2 hours
# 6. Check if session is marked as "Suspicious" ✓

# Note: In production (with real public IPs), this variable has no effect
#       It only activates when the actual IP is private (127.x.x.x, 192.168.x.x, etc.)

# ============================================
# 11. Finance Module Settings (Phase 6)
# ============================================
# Master switch for finance module
FINANCE_MODULE_ENABLED=false

# Use new Fee table vs legacy JSONB fallback
USE_NEW_FEE_TABLE=false

# Enable online payment gateways (VNPay, MoMo)
FINANCE_PAYMENT_GATEWAY_ENABLED=false

# Require two-person verification for manual payments (Maker-Checker)
FINANCE_MAKER_CHECKER_ENABLED=true

# 🚨 FEE GATE: Block enrollment if tuition fee not paid/waived
# When true: Students MUST pay tuition before enrollment
# When false: Enrollment proceeds without fee check (backward compatible)
ENABLE_FEE_VERIFICATION=false
# Admission fee gate mode (ADR-002). Only effective when ENABLE_FEE_VERIFICATION=true.
# 'legacy' = tuition fee must be paid or waived (current behavior)
# 'semester_hk1' = HK1 financial clearance (partial payment passes gate)
# IMPORTANT: only enable semester_hk1 after PR 1 migration has been deployed
ADMISSION_FEE_GATE_MODE=legacy
# Overdue notification rollout date (PR 8). Set to the deploy date to prevent
# burst-notifying all historically overdue invoices on first beat run.
# Format: YYYY-MM-DD. When unset: notify ALL overdue invoices.
# OVERDUE_NOTIFY_SINCE=2026-04-12

# ============================================
# 12. VNPay Payment Gateway (if enabled)
# ============================================
# Get credentials from VNPay merchant portal
# Sandbox docs: https://sandbox.vnpayment.vn/apis/
# VNPAY_TMN_CODE=""
# VNPAY_HASH_SECRET=""
# VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# ============================================
# 13. MoMo Payment Gateway (if enabled)
# ============================================
# Get credentials from MoMo merchant portal
# Docs: https://developers.momo.vn/v3/docs/payment/api/collection-link/
# MOMO_PARTNER_CODE=""
# MOMO_ACCESS_KEY=""
# MOMO_SECRET_KEY=""
# MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# ============================================
# Production Checklist:
# ============================================
# Before deploying to production, ensure:
# [ ] APP_ENV="production"
# [ ] DEBUG=False
# [ ] Strong SECRET_KEY and JWT_SECRET_KEY (use secrets.token_urlsafe(32))
# [ ] PostgreSQL database with strong password
# [ ] Redis with authentication if exposed
# [ ] Production mail server (not Mailtrap/MailHog)
# [ ] HTTPS for FRONTEND_URL and API_BASE_URL
# [ ] CORS_ORIGINS limited to your domains only
# [ ] LOG_LEVEL="INFO" or "WARNING"
# [ ] Regular database backups configured
# [ ] SSL/TLS certificates configured
# ============================================
