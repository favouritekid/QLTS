# =============================================================================
# Frontend Environment Variables
# =============================================================================
# NEXT_PUBLIC_* vars are inlined at build time (cannot change at runtime)
# Other vars are available server-side only
# =============================================================================

# --- API Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# --- Feature Flags ---
NEXT_PUBLIC_FF_PERMISSION_HOOK=false
NEXT_PUBLIC_FF_ERROR_HANDLER=false
NEXT_PUBLIC_FF_STATUS_CONFIG=false
NEXT_PUBLIC_FF_STRICT_PERMISSIONS=false

# --- Error Tracking (optional) ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Server-side only (Next.js rewrites proxy) ---
BACKEND_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000
