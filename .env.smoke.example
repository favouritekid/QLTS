# Mẫu env TẦNG COMPOSE cho stack smoke — chép thành `.env.smoke` rồi điền.
# `.env.smoke` KHÔNG được commit (đã có trong .gitignore): nó chứa mật khẩu.
#
#   cp .env.smoke.example .env.smoke
#   # sinh mật khẩu: python -c "import secrets;print(secrets.token_urlsafe(24))"
#
# Tệp này chỉ cấp biến cho CHÍNH tệp compose (nội suy `${...}` và build arg).
# Biến của ứng dụng nằm ở `.env.smoke.app` — xem `.env.smoke.app.example`.

# 🔑 Mảnh chống rò production. `docker-compose.yml` khai
# `env_file: ${QLTS_ENV_FILE:-.env.production}`. Bỏ trống dòng dưới là stack smoke
# nạp nguyên cấu hình production: đo được 15-08-2026, model render ra
# `FRONTEND_URL=https://qlts.tnpc.edu.vn` cùng 18 tham chiếu Zalo.
QLTS_ENV_FILE=.env.smoke.app

POSTGRES_USER=qlts
POSTGRES_PASSWORD=DIEN_MAT_KHAU_NGAU_NHIEN_VAO_DAY
# Đóng cứng: `smoke_lib/baseline.py` từ chối mọi đích khác `qlts_smoke`.
POSTGRES_DB=qlts_smoke

# Build arg của frontend — bị NƯỚNG VÀO ẢNH lúc build, không đổi được lúc chạy.
# ⇒ ảnh frontend của stack smoke phải build RIÊNG. Dùng lại ảnh dev/prod nghĩa là
# trình duyệt gọi sang backend của stack KHÁC và mọi kết luận smoke thành vô nghĩa.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:8100

# Không phải tên miền thật. `.invalid` là TLD dành riêng (RFC 2606) nên không thể
# phân giải ra ngoài — chọn nó thay vì một tên có thật để lỡ có ai gọi thì hỏng ngay
# tại DNS chứ không đi tới máy chủ nào.
DOMAIN=smoke.invalid
