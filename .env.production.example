# =============================================================================
# QLTS Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in all CHANGE_ME values
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Domain ---
DOMAIN=yourdomain.com

# --- Application ---
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TIMEZONE=Asia/Ho_Chi_Minh

# --- Database (Docker internal) ---
POSTGRES_USER=qlts
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=qlts_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Redis (Docker internal, 3 DB instances) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND_URL=redis://redis:6379/2

# --- URLs ---
FRONTEND_URL=https://${DOMAIN}
API_BASE_URL=https://${DOMAIN}
CORS_ORIGINS=https://${DOMAIN}
BACKEND_URL=http://backend:8000
BACKEND_INTERNAL_URL=http://backend:8000

# --- Mail (SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_specific_password
MAIL_FROM=noreply@${DOMAIN}
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Security ---
DEVICE_FINGERPRINT_SALT=CHANGE_ME_openssl_rand_base64_32
MFA_ENCRYPTION_KEY=CHANGE_ME_python_fernet_generate_key
MFA_TOKEN_EXPIRE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_ATTEMPT_WINDOW_MINUTES=5
MFA_ENFORCE_ROLES=admin,manager
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
ACCOUNT_LOCKOUT_WINDOW_MINUTES=30
CSRF_PROTECTION_ENABLED=true
HIBP_CHECK_ENABLED=true
SOCKET_MAX_CONN_PER_MINUTE=60

# --- File Uploads ---
MAX_AVATAR_SIZE_MB=2

# --- Error Tracking (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Admission ---
ADMISSION_CONFIRM_TOKEN_EXPIRE_DAYS=7
ADMISSION_CONFIRM_MAX_ATTEMPTS=5
ADMISSION_CONFIRM_CCCD_DIGITS=4

# --- Casbin ---
AUTO_SYNC_TEMPLATES=false

# --- Gunicorn ---
GUNICORN_WORKERS=2

# --- Next.js (build-time, use public domain) ---
NEXT_PUBLIC_API_URL=https://${DOMAIN}
NEXT_PUBLIC_SOCKET_URL=https://${DOMAIN}
NEXT_PUBLIC_FF_PERMISSION_HOOK=false
NEXT_PUBLIC_FF_ERROR_HANDLER=false
NEXT_PUBLIC_FF_STATUS_CONFIG=false
NEXT_PUBLIC_FF_STRICT_PERMISSIONS=false
NEXT_PUBLIC_SENTRY_DSN=
