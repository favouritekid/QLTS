# =============================================================================
# QLTS Production Environment Configuration
# =============================================================================
# 1. Copy: cp .env.production.example .env.production
# 2. Replace ALL "CHANGE_ME" values
# 3. deploy.sh validates no CHANGE_ME remains before deploying
#
# Variable names MUST match Backend_FastAPI/app/config.py Settings fields
# =============================================================================

# --- Domain ---
DOMAIN=CHANGE_ME
# Email for Let's Encrypt certificate expiry warnings (setup-ssl.sh)
CERTBOT_EMAIL=CHANGE_ME_your_real_email@example.com

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_64
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TIMEZONE=Asia/Ho_Chi_Minh

# --- PostgreSQL (used by postgres container + docker-compose DATABASE_URL) ---
POSTGRES_USER=qlts
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=qlts_production
# NOTE: DATABASE_URL is constructed in docker-compose.yml from these vars.
# Do NOT set DATABASE_URL here.

# --- Redis (internal Docker network, no password needed) ---
# NOTE: REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND_URL are set in
# docker-compose.yml. Do NOT set them here.

# --- Docker self-hosted deployment ---
# Set to true when PostgreSQL/Redis run on Docker internal network (no TLS).
# Set to false (or remove) when using managed DB/Redis with TLS.
ALLOW_DOCKER_INTERNAL_NETWORK=true

# --- URLs ---
FRONTEND_URL=https://${DOMAIN}
CORS_ORIGINS=https://${DOMAIN}

# --- Mail (must match config.py field names exactly) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_email@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_specific_password
MAIL_FROM=noreply@${DOMAIN}
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Security ---
DEVICE_FINGERPRINT_SALT=CHANGE_ME_openssl_rand_base64_32
MFA_ENCRYPTION_KEY=CHANGE_ME_python_fernet_generate_key
# Pepper cho selector backup code (HMAC-SHA256). BẮT BUỘC ở production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# App KHÔNG khởi động được nếu thiếu (app/config.py chặn ở startup).
# ⚠️ ĐỔI giá trị này = VÔ HIỆU TOÀN BỘ backup code đã phát: selector cũ
#   không còn khớp và không thể tính lại từ hash. Đổi thì phải cấp lại mã
#   cho mọi tài khoản đang bật MFA.
MFA_BACKUP_CODE_PEPPER=CHANGE_ME_python_secrets_token_urlsafe_32
# Định dạng lưu backup code — TRIỂN KHAI HAI PHA.
#   false (pha A): ghi legacy list[str]; ảnh cũ vẫn xác minh được ⇒ rollback
#                  không làm chết mã vừa phát cho người dùng.
#   true  (pha B): ghi v2 có selector. CHỈ bật khi bản reader-hiểu-v2 đã là
#                  mốc rollback an toàn và không còn kế hoạch lùi qua nó.
MFA_BACKUP_CODE_V2_WRITER_ENABLED=false
HIBP_CHECK_ENABLED=true
CSRF_PROTECTION_ENABLED=true

# --- Error Tracking (optional, leave empty to disable) ---
SENTRY_DSN=

# --- Casbin ---
AUTO_SYNC_TEMPLATES=false

# --- Gunicorn ---
GUNICORN_WORKERS=2

# --- Next.js (build-time ARGs, use public domain) ---
NEXT_PUBLIC_API_URL=https://${DOMAIN}
NEXT_PUBLIC_SOCKET_URL=https://${DOMAIN}

# --- School contact info (shared across email + Zalo ZNS channels) ---
# Physical address for email footers + Zalo notification address param.
# Default aligns with existing email_service literal; override if campus moves.
# NOTE: value MUST be double-quoted — deploy.sh runs `set -a; source .env.production`
# which would otherwise interpret Vietnamese diacritics as separate commands.
SCHOOL_ADDRESS="02 Lý Nhân Tông, Phường Tân An, Tỉnh Đắk Lắk"
# Bank info for email templates + admin reference. Values sourced from public
# ZNS template 557767 preview on business.zalo.solutions (already public info).
# Template 557767 itself does NOT read these; bank_transfer_note is composed
# from payload fields (ho_va_ten + profile_code + ten_nganh) via
# app/utils/text_helpers.py::to_bank_transfer_note.
SCHOOL_BANK_NAME="Vietinbank"
SCHOOL_BANK_ACCOUNT="118000130705"
SCHOOL_BANK_HOLDER="Truong Cao dang Bach khoa Tay Nguyen"

# --- Zalo OA / ZNS (populated per-environment, do NOT commit real values) ---
# App = qltsTnpcEduVn (see developers.zalo.me after login). Secrets obtained
# via admin console + OAuth flow — see Documents/ZNS_PHASE_AB_PLAN_2026-04-19.md.
ZALO_ENABLED=True
ZALO_APP_ID=CHANGE_ME_zalo_app_id
ZALO_APP_SECRET=CHANGE_ME_zalo_app_secret
ZALO_OA_ID=CHANGE_ME_zalo_oa_id
# Initial refresh token from OAuth bootstrap. After first successful send, the
# gateway rotates + persists to zalo_token_store table — this value becomes
# only the bootstrap seed (gateway reads DB first).
ZALO_REFRESH_TOKEN=CHANGE_ME_zalo_refresh_token
# Leave EMPTY so the gateway falls back to ZALO_APP_SECRET for HMAC webhook
# verification. Zalo's OA webhook spec does not define a separate "webhook
# secret" — signing uses the app secret. Override only if a future Zalo
# release introduces a dedicated webhook secret.
# Ref: app/gateways/zalo.py:verify_webhook_signature
ZALO_WEBHOOK_SECRET=

# --- Kill-switch kế toán — fail-closed ---
# ⚠️ KHÔNG đặt hai biến này cho tới khi ADR-003 cutover xong. Thiếu biến =
# mặc định False = CHẶN. Đó là trạng thái ĐÚNG, không phải thiếu sót cấu hình.
#
#   ACCOUNTING_PERIOD_CLOSE_ENABLED — bật thì PUT /api/accounting/periods/{id}/close
#     chạy thật. payment_date (ngày nghiệp vụ) và ngày ghi sổ là hai trường độc
#     lập, không ràng buộc cùng tháng; đóng kỳ chốt theo kỳ và kỳ KHÔNG mở lại
#     được, nên phiếu lệch tháng bị chốt nhầm là chốt vĩnh viễn.
#
#   INVOICE_PENALTY_ENABLED — bật thì POST /api/invoices/{id}/apply-penalty chạy thật.
#     Ba callsite tính "còn nợ" đang BỎ penalty_amount (routers/fees.py,
#     services/invoice_service.py, services/fee_calculation_service.py); cái
#     thứ ba quyết định status = paid.
#
# ⚠️ Kho này là PUBLIC. Mô tả ở đây dừng ở mức CƠ CHẾ; trạng thái vận hành cụ
# thể (đã chạy hay chưa, bao nhiêu bản ghi, đo ngày nào) giữ ở hồ sơ NGOÀI repo.
#
# Đổi hai biến này KHÔNG có tác dụng bằng `docker compose restart` — env được
# nướng vào container lúc TẠO. Phải `up -d` để Compose dựng lại container.
# ACCOUNTING_PERIOD_CLOSE_ENABLED=False
# INVOICE_PENALTY_ENABLED=False
