# nginx runtime config SINH RA bởi deploy.sh Step 3 (`envsubst` từ
# nginx/conf.d/default.conf.template với ${DOMAIN} + ${NGINX_ADMISSION_FROZEN}).
# Chỉ .template là nguồn sự thật. Trước đây file sinh ra này KHÔNG được ignore
# nên `git status` trên prod LUÔN bẩn — khiến người vận hành quen mắt bỏ qua
# trạng thái bẩn, và 5 thay đổi tay khác nằm đó nhiều tháng không ai thấy
# (audit 2026-07-20).
# `nginx/conf.d/default.conf` KHONG con duoc sinh trong repo: tu 12-08-2026
# template nam o `nginx/templates/` va entrypoint nginx render thang vao
# `/etc/nginx/conf.d` BEN TRONG container. Dong ignore cu tung che dau viec
# ban render la artifact ngoai git — va do la goc cua su co cutover.

# Fixture cuc bo cua e2e nginx packaging (sinh tai cho, khong commit)
nginx-test-certs/
nginx-test.env

# Bộ smoke sinh file id sau khi gieo dữ liệu (mỗi lần chạy một bộ id khác nhau).
# Ignore để `git status` không bẩn sau mỗi lần chạy — trạng thái bẩn quen mắt là
# cách bỏ sót thay đổi thật (xem ghi chú nginx/conf.d ở trên).
Backend_FastAPI/smoke_ids.json
Backend_FastAPI/smoke_ids.json.tmp

# Fixture E2E nginx-packaging — SINH TẠI CHỖ, không commit.
# README của thư mục ấy dựng chứng thư tự ký, tệp env riêng, và một bản template
# cắt cụt sinh ra từ chính template production (để nó không trôi lệch khỏi bản
# thật). Không thứ nào được vào git: chứng thư là bí mật, tệp env chứa giá trị
# giả dễ bị nhầm là thật, và bản cắt cụt commit vào là ngày mai nó lệch.
tests-e2e/nginx-packaging/nginx-test-certs/
tests-e2e/nginx-packaging/nginx-test.env
tests-e2e/nginx-packaging/khong-co-https/

# Manifest tài sản rollback — SINH TRÊN MÁY CHỦ ở RUNBOOK §5.4, không commit.
# Nó ghi container ID + image ID của bản đang phục vụ tại thời điểm cutover, tức
# một sự thật của MỘT máy tại MỘT thời điểm; đưa vào git là mời người ta tin
# một manifest của máy khác.
rollback_manifest_*.txt
